@model Aluno
@{
    ViewData["Title"] = "Editar aluno";
}

<div class="form-panel">
    <h1 class="h2 mb-4">Editar aluno</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-pulso">Salvar alterações</button>
            <a class="btn btn-pulso-outline" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
