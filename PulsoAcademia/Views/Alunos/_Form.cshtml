@model Aluno

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-7">
        <label asp-for="NomeCompleto" class="form-label"></label>
        <input asp-for="NomeCompleto" class="form-control" placeholder="Ex.: Mariana Souza Lima" />
        <span asp-validation-for="NomeCompleto" class="text-danger"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" placeholder="aluno@email.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DataNascimento" class="form-label"></label>
        <input asp-for="DataNascimento" class="form-control" />
        <span asp-validation-for="DataNascimento" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DataMatricula" class="form-label"></label>
        <input asp-for="DataMatricula" class="form-control" />
        <span asp-validation-for="DataMatricula" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Plano" class="form-label"></label>
        <select asp-for="Plano" class="form-select" asp-items="Html.GetEnumSelectList<Plano>()"></select>
        <span asp-validation-for="Plano" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Modalidade" class="form-label"></label>
        <select asp-for="Modalidade" class="form-select" asp-items="(SelectList)ViewBag.Modalidades">
            <option value="">Selecione a modalidade</option>
        </select>
        <span asp-validation-for="Modalidade" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Mensalidade" class="form-label"></label>
        <input asp-for="Mensalidade" class="form-control" type="number" step="0.01" min="0.01" placeholder="Ex.: 149.90" />
        <span asp-validation-for="Mensalidade" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="PesoKg" class="form-label"></label>
        <input asp-for="PesoKg" class="form-control" type="number" step="0.1" placeholder="Opcional" />
        <span asp-validation-for="PesoKg" class="text-danger"></span>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="Ativo" class="form-check-input" />
            <label asp-for="Ativo" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Objetivo" class="form-label"></label>
        <textarea asp-for="Objetivo" class="form-control" rows="3"
                  placeholder="Meta do aluno, lesões, restrições, horário preferido"></textarea>
        <span asp-validation-for="Objetivo" class="text-danger"></span>
    </div>
</div>
