@model Aluno
@{
    ViewData["Title"] = Model.NomeCompleto;
    var culturaBr = new System.Globalization.CultureInfo("pt-BR");
    var pesoTexto = Model.PesoKg.HasValue
        ? Model.PesoKg.Value.ToString("0.0", culturaBr) + " kg"
        : "Não informado";
}

<div class="form-panel">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
            <h1 class="h2 mb-1">@Model.NomeCompleto</h1>
            <p class="text-muted mb-0">@Model.Email</p>
        </div>
        <status-matricula ativo="Model.Ativo"></status-matricula>
    </div>

    <dl class="detalhes">
        <dt>@Html.DisplayNameFor(m => m.DataNascimento)</dt>
        <dd><data-br valor="Model.DataNascimento"></data-br> (@Model.Idade anos)</dd>

        <dt>@Html.DisplayNameFor(m => m.DataMatricula)</dt>
        <dd><data-br valor="Model.DataMatricula"></data-br></dd>

        <dt>@Html.DisplayNameFor(m => m.Plano)</dt>
        <dd><plano-badge valor="@Model.Plano"></plano-badge></dd>

        <dt>@Html.DisplayNameFor(m => m.Modalidade)</dt>
        <dd>@Model.Modalidade</dd>

        <dt>@Html.DisplayNameFor(m => m.Mensalidade)</dt>
        <dd><valor-brl valor="Model.Mensalidade"></valor-brl></dd>

        <dt>@Html.DisplayNameFor(m => m.PesoKg)</dt>
        <dd>@pesoTexto</dd>

        <dt>@Html.DisplayNameFor(m => m.Objetivo)</dt>
        <dd>@(string.IsNullOrWhiteSpace(Model.Objetivo) ? "Sem observações" : Model.Objetivo)</dd>
    </dl>

    <div class="d-flex gap-2 mt-4">
        <a class="btn btn-pulso" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn btn-perigo" asp-action="Delete" asp-route-id="@Model.Id">Excluir</a>
        <a class="btn btn-pulso-outline" asp-action="Index">Voltar à lista</a>
    </div>
</div>
